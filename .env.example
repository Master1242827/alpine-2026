# Copie este arquivo para .env na VPS e preencha os valores do Admin → Pagamentos.
# NUNCA committe o .env real no Git.

# --- Públicas (frontend) ---
VITE_SUPABASE_URL=https://dxrfmfozqdgvtianmjcu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=dxrfmfozqdgvtianmjcu

# --- Servidor (NUNCA expor publicamente) ---
SUPABASE_URL=https://dxrfmfozqdgvtianmjcu.supabase.co
SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_PUBLISHABLE_KEY

# Opcional: só use se quiser que este servidor acesse o banco diretamente.
# Não é necessário para o modo espelhado.
# SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SERVICE_ROLE_KEY

# Conexão com a instalação principal (modo espelhado).
# Pegue esses dois valores em Admin → Pagamentos → "Conexão do servidor externo".
CHECKOUT_API_BASE_URL=https://project--b370b26e-0ef1-41ec-ae73-c00c6755b5d3.lovable.app/api/public/checkout
CHECKOUT_API_TOKEN=COLE_AQUI_CHECKOUT_API_TOKEN

# Opcional: para operações administrativas no servidor externo.
ADMIN_API_BASE_URL=https://project--b370b26e-0ef1-41ec-ae73-c00c6755b5d3.lovable.app/api/public/admin
ADMIN_API_TOKEN=COLE_AQUI_ADMIN_API_TOKEN

# Mercado Pago (só necessário se este servidor for processar pagamentos sozinho).
# No modo espelhado, deixe vazio — o processamento é feito pela instalação principal.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=COLE_AQUI_MP_PUBLIC_KEY
MERCADO_PAGO_WEBHOOK_SECRET=

# Frenet / frete (fallback local, opcional)
FRENET_TOKEN=
ORIGIN_CEP=

# Segurança da sessão administrativa simples
ADMIN_SESSION_SECRET=COLE_AQUI_UMA_STRING_FORTE_OU_DEIXE_O_SCRIPT_GERAR
SESSION_SECRET=COLE_AQUI_UMA_STRING_FORTE_OU_DEIXE_O_SCRIPT_GERAR

# Código de bootstrap antigo (mantido para compatibilidade)
ADMIN_BOOTSTRAP_CODE=COLE_AQUI_ADMIN_CODE

# Servidor Node
PORT=3000
NODE_ENV=production
